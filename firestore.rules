rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function to check if request is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // 1. Users collection
    // Readable publicly for registration NIM check and class roster
    // Authenticated users can create/update their profile and manage users
    match /users/{userId} {
      allow read: if true;
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['telegramChatId', 'telegramUsername', 'telegramConnected', 'telegramPairingCode', 'updatedAt']);
      allow delete: if isAuthenticated();
    }

    // 2. Classes collection
    // Public read so registration page can fetch class lists
    match /classes/{classId} {
      allow read: if true;
      allow create, update, delete: if isAuthenticated();
    }

    // 3. Meetings collection
    match /meetings/{meetingId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAuthenticated();
    }

    // 4. Payments collection
    match /payments/{paymentId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAuthenticated();
    }

    // 5. Expenses collection
    match /expenses/{expenseId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAuthenticated();
    }

    // 6. Other Incomes collection
    match /otherIncomes/{incomeId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAuthenticated();
    }

    // 7. Savings Transactions collection
    match /savingsTransactions/{txnId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAuthenticated();
    }

    // 8. Audit Logs collection (append-only, immutable)
    match /auditLogs/{logId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if false;
    }

    // 9. Notification Logs collection
    match /notificationLogs/{notifId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAuthenticated();
    }
  }
}
